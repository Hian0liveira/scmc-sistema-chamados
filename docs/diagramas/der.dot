digraph G { graph [fontname="Arial",fontsize=11,bgcolor="white",pad="0.22",nodesep="0.45",ranksep="0.55"]; node [fontname="Arial",fontsize=10,color="#31547a",fontcolor="#15283e",style="rounded,filled",fillcolor="#edf4fb",penwidth=1.2]; edge [fontname="Arial",fontsize=9,color="#52677e",fontcolor="#24384d",penwidth=1.1,arrowsize=.75]; rankdir=LR; Usuario [shape=record,label="{USUARIO|PK id_usuario\lnome\lemail (único)\lperfil\lativo\l}"]; Ordem [shape=record,label="{ORDEM_SERVICO|PK id_ordem\lnumero (único)\ltitulo, descricao\lprioridade, status\laberta_em, atualizada_em\lconcluida_em, solucao\lFK solicitante_id\lFK tecnico_id (opcional)\lFK equipamento_id\l}"]; Equip [shape=record,label="{EQUIPAMENTO|PK id_equipamento\lpatrimonio (único)\ltipo, marca, modelo\llocalizacao, status\l}"]; Usuario -> Ordem [label="solicitante 1:N"]; Usuario -> Ordem [label="técnico 0..1:N",style=dashed]; Equip -> Ordem [label="equipamento 1:N"]; }