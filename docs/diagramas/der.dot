digraph CyrexDER { graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.7, fontname="Arial", label="DER – Cyrex Suporte", labelloc=t, fontsize=18]; node [shape=record, fontname="Arial", fontsize=10, style="filled", fillcolor="#f6f8ff", color="#6577d8"]; edge [fontname="Arial", fontsize=9, color="#52627a"]; Pessoa [label="{Pessoa|PK id\lnome, email, senha_hash\lperfil, função, setor\ltelefone, ramal, ativo\l}"]; Equipamento [label="{Equipamento|PK id\lpatrimônio, tipo\lmarca, modelo, serial\ldescrição, setor, status\l}"]; Chamado [label="{Chamado|PK id\lnúmero, assunto, descrição\lprioridade, status, datas\lsolução\lFK solicitante_id\lFK técnico_id (opcional)\lFK equipamento_id\l}"]; Resposta [label="{Resposta|PK id\lFK chamado_id\lFK pessoa_id\lmensagem, data\l}"]; Registro [label="{RegistroAtividade|PK id\lFK ator_id (opcional)\lação, entidade, registro\ldetalhes, data\l}"]; Pessoa -> Chamado [label="solicita 1:N"]; Pessoa -> Chamado [label="atende 1:N", style=dashed]; Equipamento -> Chamado [label="associado 1:N"]; Chamado -> Resposta [label="possui 1:N"]; Pessoa -> Resposta [label="escreve 1:N"]; Pessoa -> Registro [label="realiza 1:N"]; Chamado -> Registro [label="gera 1:N", style=dashed]; }
