digraph SeqUC01 { graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.65, fontname="Arial", label="Sequência UC01 – abrir e acompanhar chamado", labelloc=t, fontsize=16]; node [shape=box, style="rounded,filled", fillcolor="#f3f5ff", color="#6a7ce0", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#52627a"]; A [label="Solicitante"]; I [label="Interface"]; F [label="Flask"]; D [label="SQLite"]; A -> I [label="1. preencher e enviar"]; I -> F [label="2. POST /orders/new"]; F -> F [label="3. validar perfil, setor e campos"]; F -> D [label="4. inserir chamado"]; D -> F [label="5. confirmar gravação"]; F -> D [label="6. registrar atividade"]; F -> I [label="7. mostrar número/status"]; I -> A [label="8. exibir confirmação"]; }
