digraph SeqUC05 { graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.65, fontname="Arial", label="Sequência UC05 – consultar histórico e rastreabilidade", labelloc=t, fontsize=16]; node [shape=box, style="rounded,filled", fillcolor="#f3f5ff", color="#6a7ce0", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#52627a"]; A [label="Usuário autenticado"]; I [label="Tela Chamados"]; F [label="Flask"]; D [label="SQLite"]; A -> I [label="1. pesquisar e abrir chamado"]; I -> F [label="2. GET /orders e /orders/id"]; F -> F [label="3. aplicar escopo pelo perfil"]; F -> D [label="4. buscar chamado, respostas e log"]; D -> F [label="5. devolver registros associados"]; F -> I [label="6. montar lista e histórico"]; I -> A [label="7. exibir dados permitidos"]; }
