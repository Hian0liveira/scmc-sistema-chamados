digraph SeqUC04 { graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.65, fontname="Arial", label="Sequência UC04 – atender e concluir chamado", labelloc=t, fontsize=16]; node [shape=box, style="rounded,filled", fillcolor="#f3f5ff", color="#6a7ce0", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#52627a"]; A [label="Técnico/Admin"]; I [label="Detalhes do chamado"]; F [label="Flask"]; D [label="SQLite"]; A -> I [label="1. registrar resposta/status/prioridade"]; I -> A [label="2. pedir confirmação"]; A -> I [label="3. confirmar alteração"]; I -> F [label="4. POST /orders/id/edit ou response"]; F -> F [label="5. validar papel e solução"]; F -> D [label="6. salvar atualização/resposta"]; D -> F [label="7. confirmar e registrar auditoria"]; F -> I [label="8. mostrar histórico atualizado"]; }
