digraph SeqUC03 { graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.65, fontname="Arial", label="Sequência UC03 – gerenciar equipamentos", labelloc=t, fontsize=16]; node [shape=box, style="rounded,filled", fillcolor="#f3f5ff", color="#6a7ce0", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#52627a"]; A [label="Administrador"]; I [label="Tela Equipamentos"]; F [label="Flask"]; D [label="SQLite"]; A -> I [label="1. informar patrimônio e dados"]; I -> F [label="2. POST /equipment/new ou edit"]; F -> F [label="3. validar unicidade e campos"]; F -> D [label="4. inserir/atualizar equipamento"]; D -> F [label="5. confirmar gravação"]; F -> D [label="6. registrar ação"]; F -> I [label="7. atualizar inventário"]; I -> A [label="8. mostrar confirmação"]; }
