digraph G { graph [fontname="Arial",fontsize=11,bgcolor="white",pad="0.22",nodesep="0.45",ranksep="0.55"]; node [fontname="Arial",fontsize=10,color="#31547a",fontcolor="#15283e",style="rounded,filled",fillcolor="#edf4fb",penwidth=1.2]; edge [fontname="Arial",fontsize=9,color="#52677e",fontcolor="#24384d",penwidth=1.1,arrowsize=.75]; rankdir=LR; Usuario [shape=record,label="{Usuario|id: int\lnome: str\lemail: str\lperfil: str\lativo: bool\l|abrirOrdem()\latualizarPerfil()\l}"]; Ordem [shape=record,label="{OrdemServico|id: int\lnumero: str\ltitulo: str\ldescricao: str\lprioridade: str\lstatus: str\laberta_em: datetime\lsolucao: str\l|atualizarStatus()\lencerrar(solucao)\l}"]; Equip [shape=record,label="{Equipamento|id: int\lpatrimonio: str\ltipo: str\lmarca: str\lmodelo: str\llocalizacao: str\lstatus: str\l|atualizar()\l}"]; Usuario->Ordem [label="solicitante / técnico"]; Equip->Ordem [label="1 para muitas"]; }