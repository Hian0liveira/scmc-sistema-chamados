digraph CyrexClasses { graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.7, fontname="Arial", label="Classes do domínio – Cyrex Suporte", labelloc=t, fontsize=18]; node [shape=record, fontname="Arial", fontsize=10, style="filled", fillcolor="#f6f8ff", color="#6577d8"]; edge [fontname="Arial", fontsize=9, color="#52627a"]; Pessoa [label="{Pessoa|id: int\lnome: texto\lemail: texto\lperfil: enum\lfunção, setor, telefone, ramal\lativo: bool\l|autenticar()\linativar()\l}"]; Equipamento [label="{Equipamento|id: int\lpatrimônio: texto\ltipo, marca, modelo\lserial: texto?\ldescrição: texto?\lsetor, status\l|cadastrar()\latualizar()\l}"]; Chamado [label="{Chamado|id: int\lnúmero: texto\lassunto, descrição\lprioridade, status\lsolução, datas\l|abrir()\latualizar()\lconcluir()\l}"]; Resposta [label="{Resposta|id: int\lmensagem: texto\ldata: datetime\l|registrar()\l}"]; Registro [label="{RegistroAtividade|id: int\lação, detalhes\lentidade, data\l|registrar()\l}"]; Pessoa -> Chamado [label="solicitante 1"]; Pessoa -> Chamado [label="técnico 0..1", style=dashed]; Equipamento -> Chamado [label="0..* chamados"]; Chamado -> Resposta [label="1 para 0..*"]; Pessoa -> Resposta [label="autor"]; Pessoa -> Registro [label="ator"]; }
