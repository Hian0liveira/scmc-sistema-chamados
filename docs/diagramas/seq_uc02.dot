digraph SeqUC02 { graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.65, fontname="Arial", label="Sequência UC02 – gerenciar pessoas", labelloc=t, fontsize=16]; node [shape=box, style="rounded,filled", fillcolor="#f3f5ff", color="#6a7ce0", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#52627a"]; A [label="Administrador"]; I [label="Tela Pessoas"]; F [label="Flask"]; D [label="SQLite"]; A -> I [label="1. selecionar cadastro/perfil"]; I -> F [label="2. POST /users/new ou edit"]; F -> F [label="3. autorizar Admin e validar dados"]; F -> D [label="4. gravar hash e dados de pessoa"]; D -> F [label="5. confirmar gravação"]; F -> D [label="6. registrar auditoria"]; F -> I [label="7. atualizar lista"]; I -> A [label="8. exibir resultado"]; }
