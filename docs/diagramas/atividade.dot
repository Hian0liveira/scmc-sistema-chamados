digraph G { graph [size="7,8",fontname="Arial",fontsize=9,bgcolor="white",pad="0.22",nodesep="0.25",ranksep="0.25"]; node [fontname="Arial",fontsize=8,color="#31547a",fontcolor="#15283e",style="rounded,filled",fillcolor="#edf4fb",margin="0.08,0.04",penwidth=1.2]; edge [fontname="Arial",fontsize=8,color="#52677e",fontcolor="#24384d",penwidth=1.1,arrowsize=.75]; rankdir=TB; start [label="Início",shape=circle,fillcolor="#dff3e7"]; req [label="Receber solicitação",shape=box]; valid [label="Validar campos",shape=diamond,style=filled,fillcolor="#fff4df"]; err [label="Exibir erros e corrigir",shape=box]; create [label="Criar ordem como Aberta",shape=box]; attend [label="Analisar e atribuir técnico",shape=box]; update [label="Registrar diagnóstico e solução",shape=box]; sol [label="Solução preenchida?",shape=diamond,style=filled,fillcolor="#fff4df"]; fix [label="Solicitar complemento",shape=box]; close [label="Concluir e registrar data",shape=box]; end [label="Fim",shape=doublecircle,fillcolor="#dff3e7"]; start->req->valid; valid->err [label="Não"]; err->valid; valid->create [label="Sim"]; create->attend->update->sol; sol->fix [label="Não"]; fix->update; sol->close [label="Sim"]; close->end; }