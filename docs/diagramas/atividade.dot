digraph CyrexActivity { graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.42, fontname="Arial", label="Atividade – atendimento de chamado", labelloc=t, fontsize=18]; node [fontname="Arial", fontsize=10, style="filled", fillcolor="#f4f6ff", color="#6678dc"]; edge [fontname="Arial", fontsize=9, color="#52627a"]; start [shape=circle, label="", width=.18, fillcolor="#4056d9"]; login [shape=box, style="rounded,filled", label="Solicitante autenticado
preenche o chamado"]; validate [shape=diamond, label="Dados válidos e
equipamento do setor?"]; error [shape=box, style="rounded,filled", label="Mostrar erro e
solicitar correção"]; create [shape=box, style="rounded,filled", label="Criar chamado
status Aberta"]; attend [shape=box, style="rounded,filled", label="Técnico analisa, responde
e atualiza status/prioridade"]; solved [shape=diamond, label="Solução disponível?"]; wait [shape=box, style="rounded,filled", label="Aguardar complemento
ou nova ação técnica"]; close [shape=box, style="rounded,filled", label="Registrar solução, data
e status Concluída"]; end [shape=doublecircle, label="", width=.2, fillcolor="#4056d9"]; start -> login -> validate; validate -> error [label="Não"]; error -> login; validate -> create [label="Sim"]; create -> attend -> solved; solved -> wait [label="Não"]; wait -> attend; solved -> close [label="Sim"]; close -> end; }
